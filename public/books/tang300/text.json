{
  "id": "tang300",
  "title": "唐詩三百首（選）",
  "chapters": [
    {
      "index": 0,
      "title": "靜夜思 · 李白",
      "paragraphs": [
        {
          "sentences": [
            { "text": "床前明月光" },
            { "text": "疑是地上霜" },
            { "text": "舉頭望明月" },
            { "text": "低頭思故鄉" }
          ]
        }
      ]
    },
    {
      "index": 1,
      "title": "春曉 · 孟浩然",
      "paragraphs": [
        {
          "sentences": [
            { "text": "春眠不覺曉" },
            { "text": "處處聞啼鳥" },
            { "text": "夜來風雨聲" },
            { "text": "花落知多少" }
          ]
        }
      ]
    },
    {
      "index": 2,
      "title": "登鸛雀樓 · 王之渙",
      "paragraphs": [
        {
          "sentences": [
            { "text": "白日依山盡" },
            { "text": "黃河入海流" },
            { "text": "欲窮千里目" },
            { "text": "更上一層樓" }
          ]
        }
      ]
    },
    {
      "index": 3,
      "title": "黃鶴樓送孟浩然之廣陵 · 李白",
      "paragraphs": [
        {
          "sentences": [
            { "text": "故人西辭黃鶴樓" },
            { "text": "煙花三月下揚州" },
            { "text": "孤帆遠影碧空盡" },
            { "text": "唯見長江天際流" }
          ]
        }
      ]
    }
  ]
}
